+function applyRangeValues(){
+  if(!DATA||LIVE_METRICS.active)return;
+  const inputs=['range-start-value','range-end-value'].map(id=>document.getElementById(id));
+  let [a,b]=inputs.map(input=>input.value.trim()===''?NaN:Number(input.value));
+  if(!Number.isFinite(a)||!Number.isFinite(b)){setStatus('请输入有效的分析区间起止值',true);syncRangeValues();return;}
+  if(a>b)[a,b]=[b,a];
+  const first=DATA.time.findIndex(t=>t>=a);let last=DATA.time.length-1;
