    <exclude body1="left_knee_link"         body2="left_knee_mid_link"/>
    <exclude body1="right_hip_yaw_link"     body2="right_knee_mid_link"/>
    <exclude body1="left_hip_yaw_link"      body2="left_knee_mid_link"/>
    <!-- 下面 4 条是扫掠全部行程后新发现的浅穿透（mesh 建模公差，非真实干涉）：
         ankle_link <-> knee_mid_link：knee_up 在 -15.5°~-5.5° 时穿透，最深 1.8 mm
             —— 正好落在正常屈膝范围内，不加会持续产生虚假接触力，必须排除。
         knee_link  <-> knee_up_link ：knee_up 在 +34° 以上穿透，最深 4.4 mm
             —— 在 knee_up 行程（-70°~+30°）之外，本来也走不到；
                排除它是为了万一限位被顶穿时不产生假力。
         实测确认：排除前后 knee_up 的跟得上区间完全一致（伸展 +30°、屈曲 -70°），
         所以这些接触不是行程边界的原因 —— 伸展侧的边界是四杆机构力臂趋零。 -->
    <exclude body1="right_ankle_link"       body2="right_knee_mid_link"/>
    <exclude body1="left_ankle_link"        body2="left_knee_mid_link"/>
    <exclude body1="right_knee_link"        body2="right_knee_up_link"/>
    <exclude body1="left_knee_link"         body2="left_knee_up_link"/>
    </contact>


    <equality>
      <connect site1="right_knee_mid_closure" site2="right_knee_mid" solref="0.005 1" solimp="0.99 0.999 0.001"/>
        <connect site1="left_knee_mid_closure" site2="left_knee_mid" solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </equality>


    <sensor>
        <framequat name="imu_quat" objtype="site" objname="imu" />
        <gyro name="imu_ang_vel" site="imu" />
        <velocimeter name="imu_lin_vel" site="imu" />
        <accelerometer name="imu_acc" site="imu" />
        <framepos name="frame_pos" objtype="site" objname="imu" />
        <framelinvel name="frame_vel" objtype="site" objname="imu" />
        <!-- 整机绕基座质心的角动量，angular_momentum 奖励用 -->
        <subtreeangmom name="root_angmom" body="base_link" />
    </sensor>
</mujoco>
