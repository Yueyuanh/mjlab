        <exclude body1="left_knee_link"         body2="left_knee_mid_link"/>
        <exclude body1="right_hip_yaw_link"     body2="right_knee_mid_link"/>
        <exclude body1="left_hip_yaw_link"      body2="left_knee_mid_link"/>
        <exclude body1="right_ankle_link"       body2="right_knee_mid_link"/>
        <exclude body1="left_ankle_link"        body2="left_knee_mid_link"/>
        <exclude body1="right_knee_link"        body2="right_knee_up_link"/>
        <exclude body1="left_knee_link"         body2="left_knee_up_link"/>
        <!-- 结构性重叠（正常工作范围内必现的 mesh 建模公差，非真实干涉）：
             base_link <-> arm_pitch_link：肩部球头包在躯干里，零位即重叠 8.0 mm（与 hip_pitch 同类）
             ankle_link <-> knee_up_link ：knee 在 40.7°~60.2° 时穿透，最深 29.4 mm，落在正常屈膝范围内
             注：手臂与髋/腿在 arm_roll>76.5° 或 hip_pitch>132° 时的深穿透是真干涉，刻意不排除。 -->
        <exclude body1="base_link"              body2="right_arm_pitch_link"/>
        <exclude body1="base_link"              body2="left_arm_pitch_link"/>
        <exclude body1="right_ankle_link"       body2="right_knee_up_link"/>
        <exclude body1="left_ankle_link"        body2="left_knee_up_link"/>
    </contact>




    <equality>
      <connect site1="right_knee_mid_closure" site2="right_knee_mid" solref="0.005 1" solimp="0.99 0.999 0.001"/>
        <connect site1="left_knee_mid_closure" site2="left_knee_mid" solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </equality>


    <actuator>
        <!-- 电机配置：
                 DM-J4310P (±12.5 N·m): hip_pitch | hip_roll | hip_yaw | knee_up | ankle | arm_pitch | arm_roll
                 DM-J3507-2EC (±3 N·m): arm_yaw | elbow
             注：knee / knee_mid 是被动关节（四杆闭合约束），不挂执行器。 -->
        <motor name="act_Rhip_pitch" joint="right_hip_pitch_joint" ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Lhip_pitch" joint="left_hip_pitch_joint"  ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Rhip_roll"  joint="right_hip_roll_joint"  ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Lhip_roll"  joint="left_hip_roll_joint"   ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Rhip_yaw"   joint="right_hip_yaw_joint"   ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Lhip_yaw"   joint="left_hip_yaw_joint"    ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Rknee_up"   joint="right_knee_up_joint"   ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Lknee_up"   joint="left_knee_up_joint"    ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Rankle"     joint="right_ankle_joint"     ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Lankle"     joint="left_ankle_joint"      ctrllimited="true" ctrlrange="-12.5 12.5" />





        <!-- 手臂：arm_pitch / arm_roll = DM-J4310P (±12.5 N·m)，arm_yaw / elbow = DM-J3507-2EC (±3 N·m)。
             与 pikachu_v033.urdf 的 effort 对齐（arm_yaw/elbow = 3）。 -->
        <motor name="act_Rarm_pitch" joint="right_arm_pitch_joint" ctrllimited="true" ctrlrange="-12.5 12.5" />
        <motor name="act_Larm_pitch" joint="left_arm_pitch_joint"  ctrllimited="true" ctrlrange="-12.5 12.5" />
